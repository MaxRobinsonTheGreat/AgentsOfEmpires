(load "strat_pure_promi\Promisory\finaling")
#end-if
(load "strat_pure_promi\Promisory\event")

; pure_promi: full Promisory + explicit scenario target fix ONLY.
; No unit controller. A/B test vs deep_hunter to isolate the value of the dive.
(defrule
    (player-number scenario-player-1)
=>
    (set-strategic-number sn-target-player-number 2)
    (set-strategic-number sn-focus-player-number 2)
)
(defrule
    (player-number scenario-player-2)
=>
    (set-strategic-number sn-target-player-number 1)
    (set-strategic-number sn-focus-player-number 1)
)
(defrule
    (true)
=>
    (chat-to-player my-player-number "PURE-PROMI: TARGET FIX ACTIVE")
    (disable-self)
)

(include "ailib/Geometry.xs")
