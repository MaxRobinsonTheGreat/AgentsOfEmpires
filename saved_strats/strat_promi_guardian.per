; strat_promi_guardian.per - lancer offense plus a pike interceptor screen
; Four Mounted Samurai attack enemy siege. Six pikes simultaneously focus enemy
; cavalry on defensive stance, directly countering promi-lancer's four raiders.

(load "Promisory\defaultConstants")
(load "Promisory\finalingConstants")
(load "Promisory\customConstants")
#load-if-not-defined BATTLE-ROYALE
(load "Promisory\init")
(load "Promisory\threats")
(load "Promisory\escrow")
(load "Promisory\dawn")
(load "Promisory\gatherers")
(load "Promisory\scoutcontrol")
(load "Promisory\tsa")
(load "Promisory\watercontrol")
(load "Promisory\general")
(load "Promisory\orb")
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined INFINITE-RESOURCES-START
(load "Promisory\boarhunting")
#end-if
#end-if
#end-if
#end-if
(load "Promisory\researches")
(load "Promisory\interaction")
(load "Promisory\buildings")
(load "Promisory\units")
(load "Promisory\trade")
(load "Promisory\resign")
#else
(load "Promisory\finaling")
#end-if
(load "Promisory\event")

(defrule
    (true)
=>
    (up-change-name "promi-guardian")
    (enable-timer 50 5)
    (disable-self)
)

(defrule
    (true)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
)

; Start each pulse with clean DUC lists.
(defrule
    (timer-triggered 50)
=>
    (up-full-reset-search)
)

; Same proven four-cavalry onager dive as the champion.
(defrule
    (timer-triggered 50)
    (up-find-remote c: siege-onager c: 1)
=>
    (up-set-target-object search-remote c: 0)
    (up-find-local c: cavalry-class c: 4)
    (up-target-objects 1 action-default formation-stagger stance-aggressive)
)

; Continue through the two scorpions after the onager falls.
(defrule
    (timer-triggered 50)
    (not (up-find-remote c: siege-onager c: 1))
    (up-find-remote c: heavy-scorpion c: 1)
=>
    (up-set-target-object search-remote c: 0)
    (up-find-local c: cavalry-class c: 4)
    (up-target-objects 1 action-default formation-stagger stance-aggressive)
)

; Reset again so the interceptor search cannot inherit the siege target.
(defrule
    (timer-triggered 50)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-find-remote c: cavalry-class c: 1)
    (up-set-target-object search-remote c: 0)
    (up-find-local c: spearman-line c: 6)
    (up-target-objects 1 action-default formation-stagger stance-defensive)
)

(defrule
    (timer-triggered 50)
=>
    (enable-timer 50 5)
)

(include "ailib/Geometry.xs")
